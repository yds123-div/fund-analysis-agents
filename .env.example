# ============================================
# Fund Analysis Agents - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# [REQUIRED] At least ONE LLM API Key is required
# ============================================

# DashScope / Tongyi Qianwen (recommended, cost-effective)
DASHSCOPE_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# DeepSeek (optional)
DEEPSEEK_API_KEY=

# ============================================
# [RECOMMENDED] Notification
# ============================================

# Email notification (SMTP)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Bark push notification (iPhone)
BARK_SERVER_URL=https://api.day.app
BARK_DEVICE_KEY=

# ============================================
# [OPTIONAL] Data sources
# ============================================

# Tushare (supplementary data source)
TUSHARE_API_TOKEN=

# ============================================
# [AUTO] Infrastructure (auto-configured by setup script)
# ============================================
MYSQL_ROOT_PASSWORD=fund_analysis_2026
MYSQL_DATABASE=fund_analysis
MYSQL_PORT=3306
REDIS_PORT=6379
SERVER_PORT=8080

# ============================================
# [OPTIONAL] Observability - self-hosted Opik (LLM tracing)
# 默认指向本机自托管 Opik 的 OTLP HTTP 端点；切自托管/云或换机器只需改此值。
# 注意：OPIK_URL_OVERRIDE 是 Python/JS Opik SDK 变量，对本 Java 应用无关，不读取。
# ============================================
OPIK_OTLP_ENDPOINT=http://localhost:4318/v1/traces
